# Stylework Lead Tracker Backend Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadtracker?schema=public"

# Example for Neon serverless PostgreSQL (cloud):
# DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-cool-rain-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
